module(name = "furnace")

# furniture

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "google_benchmark", version = "1.10.0")

# clangd compile commands

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

git_override(
  module_name = "hedron_compile_commands",
  remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
  commit = "7fe1eab26d2b8eeb5e1c6a2f38bddb001e3f9696",
)

# for external repos

http_archive = use_repo_rule(
  "@bazel_tools//tools/build_defs/repo:http.bzl",
  "http_archive",
)

git_repository = use_repo_rule(
  "@bazel_tools//tools/build_defs/repo:git.bzl",
  "git_repository",
)

# SDSL

http_archive(
  name = "sdsl_lite",
  urls = ["https://github.com/xxsds/sdsl-lite/archive/refs/tags/v3.0.4.tar.gz"],
  strip_prefix = "sdsl-lite-3.0.4",
  build_file = "@//third-party:sdsl.bazel",
)

# Datasketches

http_archive(
  name = "datasketches_cpp",
  urls = ["https://github.com/apache/datasketches-cpp/archive/refs/tags/5.3.0.tar.gz"],
  strip_prefix = "datasketches-cpp-5.3.0",
  build_file = "@//third-party:datasketches.bazel",
)

# BBHash

git_repository(
  name = "bbhash",
  remote = "https://codeberg.org/SCoRE-Group/bbhash.git",
  commit = "e93a661a49c73776658499caeac0f61c900b1210",
  build_file = "@//third-party:bbhash.bazel",
)

# Cereal

http_archive(
  name = "cereal",
  urls = ["https://github.com/USCiLab/cereal/archive/refs/tags/v1.3.2.tar.gz"],
  strip_prefix = "cereal-1.3.2",
  build_file = "@//third-party:cereal.bazel",
)